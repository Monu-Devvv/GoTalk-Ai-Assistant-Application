{
  "expo": {
    "name": "GoTalk",
    "slug": "gotalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.gotalk"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yourname.gotalk"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "GoTalk needs microphone access to hear your voice.",
          "speechRecognitionPermission": "GoTalk needs speech recognition to understand you."
        }
      ]
    ]
  }
}
